# Copiar a .env SOLO para pruebas locales (el .env está en .gitignore).
# En Render estas variables se configuran en el panel (Environment). Nunca subir claves al repositorio.

PORT=4000

# Núcleo del docente. En línea: https://nucleo-tr.onrender.com
# Copia local del núcleo: http://localhost:3000 (sus tokens NO sirven en el núcleo en línea, y al revés)
NUCLEO_URL=https://nucleo-tr.onrender.com

# M1 (ES3: el simulado vive dentro del núcleo; en la ES4 cambia solo esta URL por el M1 real)
M1_URL=https://nucleo-tr.onrender.com/api/registro

# MongoDB Atlas (cadena de conexión con usuario y clave: va SOLO en variables de entorno)
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=consultorio_m4

# RUT de los veterinarios que atienden (deben existir en el núcleo con perfil veterinario)
VETERINARIOS=15555555-6,16666666-K

# Opcionales
# CORS_ORIGIN=https://otro-origen.ejemplo.cl
# LIMITE_POR_MINUTO=300
# SEED_DEMO=0
# Solo para desarrollo sin Atlas (los datos se pierden al reiniciar):
# ALLOW_MEMORY=1
